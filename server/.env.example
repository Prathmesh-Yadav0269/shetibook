# ShetiBook Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database configuration (Turso or local SQLite)
# For local dev / testing: file:./data/shetibook.db or file::memory:
# For Turso cloud: libsql://your-db.turso.io
TURSO_DATABASE_URL=file:./data/shetibook.db
TURSO_AUTH_TOKEN=your-turso-auth-token-placeholder

# Security & Sessions
SESSION_SECRET=your-random-32-byte-hex-secret-placeholder
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
